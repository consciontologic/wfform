{
  "production": "main",
  "integration": "develop",
  "branches": {
    "feature": {"from": "develop", "pull_request_into": "develop"},
    "bugfix": {"from": "develop", "pull_request_into": "develop"},
    "hotfix": {"from": "main", "pull_request_into": "main", "back_merge_into": "develop"},
    "release": {"from": "develop", "pull_request_into": "main", "back_merge_into": "develop"}
  },
  "agent_prefixes": ["codex", "claude", "copilot"],
  "semver": "MAJOR.MINOR.PATCH",
  "tag_prefix": "",
